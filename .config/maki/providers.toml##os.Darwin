[sophia-opencode-go]
display_name = "Sophia (Opencode Go)"
protocol = "openai-responses"
base_url = "http://127.0.0.1:8766/opencode-go"
api_key = "127001"
headers = { X-Conversation-Id = "${DUSHA_CONVERSATION_ID}", X-Companion-Route = "${DUSHA_ROUTE}", X-Harness = "${DUSHA_HARNESS}" }
default_model = "sophia-polystrata/gemma-4-26b-a4b"

[[sophia-opencode-go.models]]
id = "muse-spark-1.3-contributor"
tier = "medium"
context_window = 128000
max_output_tokens = 32768

[[sophia-opencode-go.models]]
id = "deepseek-v4.1-flash"
tier = "medium"
context_window = 1048576
max_output_tokens = 393216

[sophia-polystrata]
display_name = "Sophia (Polystrata)"
protocol = "openai"
base_url = "http://127.0.0.1:8766/polystrata"
api_key = "dummy"

[[sophia-polystrata.models]]
id = "gemma-4-26b-a4b"
tier = "weak"
context_window = 130000
max_output_tokens = 32768
