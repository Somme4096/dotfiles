function yadm-sync --wraps='maki "Sync yadm to/from remote under 30 seconds. Resolve conflicts only by newest. Commit semantically, push." --yolo' --description 'alias yadm-sync=maki "Sync yadm to/from remote under 30 seconds. Resolve conflicts only by newest. Commit semantically, push." --yolo'
    maki "Sync yadm to/from remote under 30 seconds. Use `yadm` command. Resolve conflicts only by newest. Commit semantically, push." --yolo $argv
end
